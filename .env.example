# ============================================================
# DB Connection
# ============================================================
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_HOST=your-server.database.windows.net
DB_PORT=1433
DB_NAME=your-database
DB_ENCRYPT=yes
DB_TRUST_CERT=no
DB_TIMEOUT=30

# ============================================================
# Authentication
# ============================================================
# ActiveDirectoryDefault -> uses your az login session (run via run.ps1)
# SqlPassword            -> uses DB_USER + DB_PASSWORD below
DB_AUTH=ActiveDirectoryDefault

# Only needed if DB_AUTH=SqlPassword
# DB_USER=sa
# DB_PASSWORD=your-password

# ============================================================
# Extraction filters (comma-separated, empty = all)
# ============================================================
# EXTRACT_SCHEMAS=dbo,Services
# EXTRACT_TABLES=dbo.Transaction,dbo.Customer
EXTRACT_SCHEMAS=
EXTRACT_TABLES=
